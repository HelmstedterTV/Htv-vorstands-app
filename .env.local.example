# Google OAuth Client ID (für Google Kalender Sync)
# Anleitung: siehe GOOGLE_SETUP.md
VITE_GOOGLE_CLIENT_ID=DEINE_CLIENT_ID_HIER.apps.googleusercontent.com

# Push-Benachrichtigungen über Firebase Cloud Messaging (FCM)
# VITE_FCM_VAPID_KEY: Firebase Console → Projekteinstellungen → Cloud Messaging
#   → "Web Push certificates" → Schlüsselpaar (öffentlicher Schlüssel)
VITE_FCM_VAPID_KEY=DEIN_WEB_PUSH_ZERTIFIKAT_HIER
# URL des Cloudflare-Workers
VITE_WORKER_URL=https://htv-push-worker.DEIN-SUBDOMAIN.workers.dev
# Gemeinsames Passwort – muss identisch zum NOTIFY_SECRET im Worker sein
VITE_NOTIFY_SECRET=DEIN_GEHEIMES_PASSWORT
