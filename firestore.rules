rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Hilfsfunktionen
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isVorstand() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'vorstand'];
    }
    function isGast() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'gast';
    }

    // Nutzerprofile
    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      allow update: if request.auth.uid == uid; // eigenes Profil editieren
    }

    // Channels
    match /channels/{channelId} {
      // Projekt-Channels nur für eingetragene Mitglieder sichtbar,
      // Vorstand/Vorstand&Gäste-Channels wie bisher für Vorstand bzw. alle (inkl. Gäste)
      allow read: if isSignedIn() &&
        (
          resource.data.type == 'vorstand_gaeste' ||
          (resource.data.type != 'projekt' && isVorstand()) ||
          (resource.data.type == 'projekt' && request.auth.uid in resource.data.members)
        );
      allow create, update, delete: if isVorstand();

      // Nachrichten – Vorstand + Gäste dürfen schreiben, Projekt-Channels nur Mitglieder
      match /messages/{msgId} {
        allow read: if isSignedIn() &&
          (
            get(/databases/$(database)/documents/channels/$(channelId)).data.type == 'vorstand_gaeste' ||
            (get(/databases/$(database)/documents/channels/$(channelId)).data.type != 'projekt' && isVorstand()) ||
            (get(/databases/$(database)/documents/channels/$(channelId)).data.type == 'projekt' &&
             request.auth.uid in get(/databases/$(database)/documents/channels/$(channelId)).data.members)
          );
        allow create: if isSignedIn() &&
          (
            get(/databases/$(database)/documents/channels/$(channelId)).data.type == 'vorstand_gaeste' ||
            (get(/databases/$(database)/documents/channels/$(channelId)).data.type != 'projekt' && isVorstand()) ||
            (get(/databases/$(database)/documents/channels/$(channelId)).data.type == 'projekt' &&
             request.auth.uid in get(/databases/$(database)/documents/channels/$(channelId)).data.members)
          );
        // Reaktionen + Abstimmungen – alle eingeloggten Nutzer dürfen diese Felder ändern
        // Eigene Nachricht bearbeiten – nur 'text' und 'editedAt' dürfen geändert werden
        allow update: if isSignedIn() && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'pollVotes']) ||
          (request.auth.uid == resource.data.authorId &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt']))
        );
        // Löschen: Verfasser darf eigene Nachricht löschen, Admin darf alle löschen
        allow delete: if isAdmin() ||
          (isSignedIn() && request.auth.uid == resource.data.authorId);
      }
    }

    // ToDos – nur Vorstand
    match /todos/{todoId} {
      allow read: if isVorstand();
      allow create, update: if isVorstand();
      allow delete: if isVorstand();
    }

    // Kalender – nur Vorstand
    match /events/{eventId} {
      allow read: if isVorstand();
      allow create, update, delete: if isVorstand();
    }

    // Sitzungen & Tagesordnungen – nur Vorstand
    match /sitzungen/{sitzungId} {
      allow read: if isVorstand();
      allow create, update, delete: if isVorstand();
    }

    // Zähler-Modul (Gas/Strom/Wasser)
    // Stammdaten, Verträge und Historie: lesen alle im Vorstand, ändern nur Admin/Vorstand
    match /zaehler/{zaehlerId} {
      allow read: if isVorstand();
      allow create, update, delete: if isVorstand();
    }
    match /zaehlerVertraege/{vertragId} {
      allow read: if isVorstand();
      allow create, update, delete: if isVorstand();
    }
    match /zaehlerHistorie/{eintragId} {
      allow read: if isVorstand();
      allow create, update, delete: if isVorstand();
    }
    // Ablesungen: Vorstand darf erfassen und eigene Korrekturen vornehmen.
    // Rechnungsstände (Quelle R/G) sind gegen Änderung und Löschung geschützt.
    match /zaehlerAblesungen/{ablesungId} {
      allow read: if isVorstand();
      allow create: if isVorstand();
      allow update: if isVorstand() && resource.data.quelle == 'A';
      allow delete: if isVorstand() && resource.data.quelle == 'A';
    }

    // Direktnachrichten – nur die beiden Teilnehmer dürfen lesen/schreiben
    match /directMessages/{convId} {
      allow read: if isSignedIn() &&
        request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.participants;
      allow update: if isSignedIn() &&
        request.auth.uid in resource.data.participants;

      match /messages/{msgId} {
        allow read: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/directMessages/$(convId)).data.participants;
        allow create: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/directMessages/$(convId)).data.participants;
        allow update: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/directMessages/$(convId)).data.participants && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'pollVotes']) ||
          (request.auth.uid == resource.data.authorId &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt']))
        );
        // Löschen: nur der Verfasser der Nachricht (muss zusätzlich Teilnehmer der DM sein)
        allow delete: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/directMessages/$(convId)).data.participants &&
          request.auth.uid == resource.data.authorId;
      }
    }

    // Lesestand pro Nutzer (für Ungelesen-Badge)
    match /userActivity/{uid} {
      allow read, write: if request.auth.uid == uid;
    }
  }
}
